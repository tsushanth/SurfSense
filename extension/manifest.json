{
  "manifest_version": 3,
  "name": "SurfSense",
  "version": "3.0",
  "description": "Track time spent on websites, view top sites, and see visual summaries by category to boost your focus.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://usage-tracker-backend-917362189743.us-central1.run.app/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

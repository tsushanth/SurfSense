# Required: Supabase connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Required: OpenAI API key (for domain categorization fallback)
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Server configuration
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Optional: CORS origins (comma-separated, empty = allow all non-browser origins)
CORS_ORIGINS=https://surfsense.app
